# Packvio staging — BEHIND-PROXY edge. Plain HTTP on one loopback port, with
# TLS, port 80, port 443 and the certificate all owned by a front proxy already
# running on this host.
#
# Rendered at container start by /docker-entrypoint.sh when PACKVIO_EDGE_MODE is
# `behind-proxy`.
#
# WHY THIS MODE EXISTS
# --------------------
# This host already runs another application whose nginx owns ports 80 and 443.
# A host port can be bound once, so starting a second nginx on :80 fails with
#
#     failed to bind host port 0.0.0.0:80/tcp: address already in use
#
# and no amount of configuration inside this container changes that — the
# collision is at the Docker port-publishing layer, before nginx runs. There are
# only three real answers: give Packvio its own IP address, move the other
# application, or put one proxy in front of both. This is the third.
#
# WHAT THE FRONT PROXY MUST DO
# ----------------------------
# See deploy/nginx/front-proxy/packvio.conf.example — a server block to add to
# the EXISTING nginx, which terminates TLS for this hostname and proxies to
# 127.0.0.1:${EDGE_HTTP_PORT}. Three things in it are load-bearing:
#
#   X-Forwarded-For    so nginx here, and the API behind it, see the real
#                      client. The RFQ rate limit is per client IP; without
#                      this every submission in the world shares one bucket.
#   X-Forwarded-Proto  set to https. Without it the apps are told the request
#                      arrived over plain HTTP.
#   Host               preserved, so $host below is the real hostname.
#
# WHAT IS DELIBERATELY ABSENT
# ---------------------------
# No 443 listener, no ssl_certificate, and no HTTP-to-HTTPS redirect. The
# redirect in particular would be a LOOP: the front proxy is already serving
# HTTPS and forwarding over HTTP, so a 301 to https:// sends the browser back
# round the same circle forever. The front proxy does that redirect, once.
#
# No ACME challenge location either. The certificate for this hostname is
# issued by whatever certbot the front proxy uses, because only the thing
# holding port 80 can answer an HTTP-01 challenge. The certbot service in
# docker-compose.prod.yml idles in this mode and says so in its log.

server {
    # default_server so a request with any Host still reaches this site. The
    # only client is the front proxy on loopback, and compose's own healthcheck
    # arrives as `Host: 127.0.0.1`, which matches no server_name.
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${PACKVIO_DOMAIN};

    # HSTS comes from snippets/security-headers.conf, as it does in standalone
    # mode. The browser sees it over the front proxy's HTTPS connection, so it
    # is honoured normally — which is why the example front-proxy block does NOT
    # add one of its own. Two Strict-Transport-Security headers on one response
    # is a configuration smell even where browsers tolerate it.

    # The Basic Auth gate, the webhook exception, the routing and the cache
    # policy — shared with the standalone mode so the two cannot drift.
    include /etc/nginx/snippets/site.conf;
}
