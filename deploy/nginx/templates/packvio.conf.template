# Packvio staging — the site.
#
# Rendered at container start by /docker-entrypoint.sh, which substitutes
# ${PACKVIO_DOMAIN} and nothing else. Every other $name below is an nginx
# runtime variable and must survive to nginx untouched.

# ---------------------------------------------------------------------------
# Port 80 — ACME challenges, and a redirect for everything else.
# ---------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name ${PACKVIO_DOMAIN};

    # MUST come before the redirect and MUST NOT require auth. Let's Encrypt
    # validates by fetching this path over plain HTTP from several places at
    # once; a 301 to HTTPS is survivable, but a 401 is not, and the certificate
    # simply never issues. `^~` stops nginx from considering any regex location
    # for this prefix.
    location ^~ /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/certbot;
        default_type "text/plain";
    }

    # Container-local liveness for compose's healthcheck. Answered here rather
    # than proxied so it stays true while an upstream is restarting, and stays
    # off the TLS server so it does not need a certificate.
    location = /healthz {
        auth_basic off;
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------------------
# Port 443 — the site.
# ---------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${PACKVIO_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${PACKVIO_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PACKVIO_DOMAIN}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/${PACKVIO_DOMAIN}/chain.pem;

    # OCSP stapling: nginx fetches the revocation proof itself and hands it to
    # the client, so the browser does not have to make its own round trip to the
    # CA before rendering anything.
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 127.0.0.11 valid=30s;
    resolver_timeout 5s;

    # HSTS is in snippets/security-headers.conf, with every other header, and
    # NOT here. Declared at this level it is inherited by no location that sets
    # an add_header of its own — which is all of them. See the note in that file.

    # -----------------------------------------------------------------------
    # HTTP Basic Auth over the whole staging site.
    #
    # Declared at SERVER level so it is the default for everything, and turned
    # off explicitly in the three locations that must stay open. A default of
    # "protected" is the safe direction to be wrong in: a new location added
    # later inherits the auth instead of appearing on the public internet.
    #
    # The password file is generated on the server and mounted read-only:
    #   htpasswd -c deploy/nginx/htpasswd packvio
    # -----------------------------------------------------------------------
    auth_basic "Packvio staging";
    auth_basic_user_file /etc/nginx/htpasswd;

    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/csp.conf;

    # =======================================================================
    # THE SALLA WEBHOOK — the one path that must stay open.
    #
    # `location = ` is an EXACT match, and exact matches are evaluated before
    # every prefix location including `/api/`. That precedence is what makes
    # this work: without the `=`, `location /api/v1/webhooks/salla` would be
    # just another prefix, and which of it and `/api/` won would depend on
    # which is longer — it is, so it would still work, but by accident rather
    # than by rule. The exact form also means it opens EXACTLY this path and
    # not, say, /api/v1/webhooks/salla-admin.
    #
    # Two blocks because Nest's router accepts the path with or without a
    # trailing slash (Express strict routing is off), so both must be open or
    # Salla appending one would meet a 401 and retry into a wall.
    #
    # This is safe to leave unauthenticated because the endpoint authenticates
    # its OWN callers: every delivery carries an HMAC signature computed over
    # the raw request bytes with SALLA_WEBHOOK_SECRET, and the controller
    # rejects anything that does not verify. Basic Auth here would add nothing
    # except a shared password that Salla has no way to send.
    # =======================================================================
    location = /api/v1/webhooks/salla {
        auth_basic off;
        include /etc/nginx/snippets/proxy.conf;
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/csp.conf;
        proxy_pass http://packvio_api;
    }

    location = /api/v1/webhooks/salla/ {
        auth_basic off;
        include /etc/nginx/snippets/proxy.conf;
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/csp.conf;
        proxy_pass http://packvio_api;
    }

    # -----------------------------------------------------------------------
    # robots.txt — served here, unauthenticated, and never from the app.
    #
    # Unauthenticated on purpose: a crawler that meets a 401 learns nothing,
    # while one that reads this is told explicitly to go away. Served by nginx
    # rather than proxied so it cannot be affected by the app being down, and so
    # that promoting this config to production means editing one file rather
    # than remembering that staging had a different app build.
    # -----------------------------------------------------------------------
    location = /robots.txt {
        auth_basic off;
        add_header Content-Type text/plain;
        include /etc/nginx/snippets/security-headers.conf;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    location = /healthz {
        auth_basic off;
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # -----------------------------------------------------------------------
    # Next's build assets. Content-hashed filenames, so the URL changes whenever
    # the bytes do — which is exactly the condition `immutable` describes. A
    # year is the maximum any browser honours.
    #
    # This location sets its own add_header, so it MUST re-include the security
    # snippets or it silently loses all of them. See the note in
    # snippets/security-headers.conf.
    # -----------------------------------------------------------------------
    location /_next/static/ {
        include /etc/nginx/snippets/proxy.conf;
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/csp.conf;
        proxy_pass http://packvio_web;

        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
    }

    # Next's optimised images. Also content-addressed by query string, but a
    # month rather than a year — the underlying source can be replaced by a
    # Salla sync without the URL changing.
    location /_next/image {
        include /etc/nginx/snippets/proxy.conf;
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/csp.conf;
        proxy_pass http://packvio_web;

        add_header Cache-Control "public, max-age=2592000" always;
    }

    # Files from public/ — fonts, the brand mark, the icon. Named by hand, so
    # they can be replaced in place; a week with revalidation, not a year.
    location ~* \.(woff2|woff|ttf|otf|svg|ico|png|jpg|jpeg|webp|avif)$ {
        include /etc/nginx/snippets/proxy.conf;
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/csp.conf;
        proxy_pass http://packvio_web;

        add_header Cache-Control "public, max-age=604800, stale-while-revalidate=86400" always;
    }

    # -----------------------------------------------------------------------
    # The API.
    #
    # `/api/v1/` AND NOT `/api/`, which is the difference between a working site
    # and a broken one. Next has route handlers of its own under /api/ —
    # /api/quote (the RFQ), /api/suggest (header autocomplete) and
    # /api/revalidate (the ISR purge Nest calls) — and Nest is mounted at
    # /api/v1. Routing the whole /api/ prefix to Nest hands it three paths it
    # has never heard of, and it answers exactly as it should:
    #
    #     {"message":"Cannot POST /api/quote","error":"Not Found","statusCode":404}
    #
    # which is a 404 on the site's primary conversion, from a container that is
    # healthy, with nothing in either app's log to suggest a proxy is at fault.
    # Matching the API's real namespace leaves every other /api/ path to fall
    # through to `location /` and reach Next, where it belongs.
    #
    # Behind Basic Auth, inherited from the server block — this is a staging box
    # and its catalog endpoints are not for the public. The webhook exception
    # above is matched first and is the only way in without a password.
    # -----------------------------------------------------------------------
    location /api/v1/ {
        include /etc/nginx/snippets/proxy.conf;
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/csp.conf;
        proxy_pass http://packvio_api;
    }

    # -----------------------------------------------------------------------
    # Everything else: the Next app.
    #
    # HTML gets a SHORT cache with revalidation, not a long one. Pages render on
    # demand and read a catalog that a Salla webhook can change at any moment;
    # the ISR layer inside Next already holds the DATA for five minutes, and a
    # long cache out here would only serve a page Next has already refreshed.
    #
    # `proxy_hide_header` is load-bearing and was added after seeing the result
    # without it. Next sends its own `Cache-Control: private, no-cache,
    # no-store, max-age=0, must-revalidate` on a dynamically rendered page;
    # `add_header` does not replace that, it APPENDS, so the response carried two
    # contradictory Cache-Control headers and the strictest — no-store — won.
    # The header below was decorative. Hiding the upstream's first makes this
    # the only one, and makes the policy something this file actually decides.
    #
    # Safe here because no HTML on this site is per-user: there are no accounts,
    # no sessions and no personalised pages. If that ever changes, this line has
    # to go with it, or a shared cache will hand one visitor another's page.
    # -----------------------------------------------------------------------
    location / {
        include /etc/nginx/snippets/proxy.conf;
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/csp.conf;
        proxy_pass http://packvio_web;

        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=0, s-maxage=60, must-revalidate" always;
    }
}
