# Packvio — server environment for docker-compose.prod.yml.
#
# Copy to `.env` NEXT TO docker-compose.prod.yml on the server, fill it in, and
# chmod it 600. It is the only place any secret exists: nothing here is baked
# into an image, and nothing here belongs in git.
#
#   cp deploy/env.prod.example .env && chmod 600 .env
#
# (The file is kept under deploy/ with a plain name rather than as
# `.env.prod.example` at the root so that a stray `cp .env.* ` or an editor's
# dotfile glob cannot pick it up alongside a real one.)
#
# Compose reads `.env` from the working directory automatically. It is NOT the
# same file the local dev stack uses — that one lives at the repo root and holds
# development values.

# ===========================================================================
# Site identity
# ===========================================================================

# The public hostname, with no scheme. nginx substitutes it into its config and
# certbot requests a certificate for exactly this name.
PACKVIO_DOMAIN=staging.example.com

# The same host with its scheme. The API uses it for CORS and as the base of the
# URL it calls back to when triggering ISR revalidation.
SITE_URL=https://staging.example.com

# ===========================================================================
# Edge mode — WHO OWNS PORTS 80 AND 443 ON THIS SERVER
#
# A host port can be bound exactly once. If another application on this box
# already publishes :80 — another compose stack's nginx, Apache, Caddy, a system
# nginx — then starting this one fails before nginx runs, with
#
#     failed to bind host port 0.0.0.0:80/tcp: address already in use
#
# and nothing inside this stack's configuration can resolve it. Find the holder:
#
#     ss -tlnp '( sport = :80 )'
#     docker ps --format '{{.Names}}\t{{.Ports}}' | grep ':80->'
#
# standalone   (default) Packvio's nginx owns :80 and :443, terminates TLS, and
#              its certbot issues and renews the certificate. Correct when
#              Packvio is the only application on the host. Needs no variables
#              below — leaving all three unset reproduces this exactly.
#
# behind-proxy Packvio's nginx serves plain HTTP on a loopback port and the
#              nginx that already holds :80/:443 proxies this hostname to it.
#              TLS, the HTTP-to-HTTPS redirect and the certificate all belong to
#              that proxy; Packvio's certbot idles and says so in its log.
#              Add the server block from
#              deploy/nginx/front-proxy/packvio.conf.example to that nginx —
#              the X-Forwarded-For line in it is load-bearing, because the RFQ
#              rate limit is per client IP.
# ===========================================================================
# EDGE_MODE=behind-proxy
# EDGE_HTTP_PUBLISH=127.0.0.1:8080
# EDGE_HTTPS_PUBLISH=127.0.0.1:8443

# ===========================================================================
# Images
#
# Set by CI to a SHA-tagged reference, so a deploy is reproducible and a
# rollback is a matter of naming the previous tag. Left unset, compose falls
# back to the `:local` tags a manual `docker compose build` produces.
# ===========================================================================
API_IMAGE=ghcr.io/OWNER/packvio-api:staging
WEB_IMAGE=ghcr.io/OWNER/packvio-web:staging

# Where Let's Encrypt sends expiry warnings, and the account the certificate is
# issued under. A real, monitored mailbox — it is the only warning you get that
# renewal has been failing.
CERTBOT_EMAIL=

# Set to 1 to issue from Let's Encrypt's STAGING endpoint while testing DNS and
# firewall. Staging certificates are untrusted by browsers but are not rate
# limited, and the production endpoint allows only 5 failures per hostname per
# hour — enough to lock yourself out for an afternoon over a typo.
CERTBOT_STAGING=0

# ===========================================================================
# Postgres
#
# Read ONCE, when the data directory is first initialised. Changing the password
# here later does not change it in the database — see DEPLOYMENT.md § Rotating
# credentials for how to do that properly.
#
#   POSTGRES_PASSWORD:  openssl rand -base64 24
# ===========================================================================
POSTGRES_USER=packvio
POSTGRES_PASSWORD=
POSTGRES_DB=packvio

# ===========================================================================
# Secret the API refuses to start without
#
# Validated at boot by Joi and fails loudly rather than falling back to
# something weaker — see apps/api/src/config/env.validation.ts.
#
#   QUOTE_IP_HASH_SALT:   openssl rand -base64 32    (32+ characters)
#
# QUOTE_IP_HASH_SALT salts the RFQ submitter IP hashes. An unsalted IP hash is
# reversed by exhausting IPv4 in minutes, so this is what makes `ip_hash` a
# column defensible under PDPL. Rotating it makes historical hashes
# incomparable with new ones — a real cost, not a free precaution.
# ===========================================================================
QUOTE_IP_HASH_SALT=

# ===========================================================================
# Operational
# ===========================================================================

# Shared secret `npm run deploy:purge` presents when asking Next to drop its
# cached catalog after a seed. Blank disables the endpoint; the purge script
# then restarts `web` instead.
#   openssl rand -base64 24
REVALIDATE_SECRET=

# RFQ submissions permitted per client IP per hour.
QUOTE_RATE_LIMIT=5

# ===========================================================================
# Backups
#
# BACKUP_HOUR_UTC is UTC, not Riyadh time. 23:00 UTC is 02:00 Asia/Riyadh —
# genuinely quiet for a Saudi B2B site, which 23:00 local is not.
# ===========================================================================
BACKUP_RETENTION_DAYS=7
BACKUP_HOUR_UTC=23

# ===========================================================================
# Staging gate — HTTP Basic Auth over the whole site
#
# on  (default)  Every path needs the username and password in
#                deploy/nginx/htpasswd, EXCEPT /robots.txt and /healthz. Create the file once on the server:
#                    htpasswd -Bc <this dir>/deploy/nginx/htpasswd packvio
#
# off            No password. The site is reachable by anyone with the URL.
#                No password file is needed.
#
# This is a "not finished yet" gate, not a security control — there is nothing
# behind it but a catalogue with no prices. Turning it off does NOT put the
# site in Google: that is SEARCH_INDEXING, below.
# ===========================================================================
# STAGING_GATE=off

# ===========================================================================
# Search indexing
#
# off (default)  X-Robots-Tag: noindex on every response and robots.txt says
#                "Disallow: /". Right for staging.
# on             Search engines may crawl and index the site; robots.txt
#                points them at /sitemap.xml. Set this when the site goes
#                public, together with STAGING_GATE=off — a site behind a
#                password cannot be indexed anyway.
#
# Optional, for Google Search Console and Bing Webmaster Tools verification
# (the codes they show you when you add the site):
#   GOOGLE_SITE_VERIFICATION=
#   BING_SITE_VERIFICATION=
# ===========================================================================
# SEARCH_INDEXING=on
