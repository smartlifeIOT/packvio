# Packvio — server environment for docker-compose.prod.yml.
#
# Copy to `.env` NEXT TO docker-compose.prod.yml on the server, fill it in, and
# chmod it 600. It is the only place any secret exists: nothing here is baked
# into an image, and nothing here belongs in git.
#
#   cp deploy/env.prod.example .env && chmod 600 .env
#
# (The file is kept under deploy/ with a plain name rather than as
# `.env.prod.example` at the root so that a stray `cp .env.* ` or an editor's
# dotfile glob cannot pick it up alongside a real one.)
#
# Compose reads `.env` from the working directory automatically. It is NOT the
# same file the local dev stack uses — that one lives at the repo root and holds
# development values.

# ===========================================================================
# Site identity
# ===========================================================================

# The public hostname, with no scheme. nginx substitutes it into its config and
# certbot requests a certificate for exactly this name.
PACKVIO_DOMAIN=staging.example.com

# The same host with its scheme. The API uses it for CORS and as the base of the
# URL it calls back to when triggering ISR revalidation.
SITE_URL=https://staging.example.com

# ===========================================================================
# Images
#
# Set by CI to a SHA-tagged reference, so a deploy is reproducible and a
# rollback is a matter of naming the previous tag. Left unset, compose falls
# back to the `:local` tags a manual `docker compose build` produces.
# ===========================================================================
API_IMAGE=ghcr.io/OWNER/packvio-api:staging
WEB_IMAGE=ghcr.io/OWNER/packvio-web:staging

# Where Let's Encrypt sends expiry warnings, and the account the certificate is
# issued under. A real, monitored mailbox — it is the only warning you get that
# renewal has been failing.
CERTBOT_EMAIL=

# Set to 1 to issue from Let's Encrypt's STAGING endpoint while testing DNS and
# firewall. Staging certificates are untrusted by browsers but are not rate
# limited, and the production endpoint allows only 5 failures per hostname per
# hour — enough to lock yourself out for an afternoon over a typo.
CERTBOT_STAGING=0

# ===========================================================================
# Postgres
#
# Read ONCE, when the data directory is first initialised. Changing the password
# here later does not change it in the database — see DEPLOYMENT.md § Rotating
# credentials for how to do that properly.
#
#   POSTGRES_PASSWORD:  openssl rand -base64 24
# ===========================================================================
POSTGRES_USER=packvio
POSTGRES_PASSWORD=
POSTGRES_DB=packvio

# ===========================================================================
# Secrets the API refuses to start without
#
# Both are validated at boot by Joi, and both fail loudly rather than falling
# back to something weaker — see apps/api/src/config/env.validation.ts.
#
#   SALLA_TOKEN_ENC_KEY:  openssl rand -base64 32    (must decode to 32 bytes)
#   QUOTE_IP_HASH_SALT:   openssl rand -base64 32    (32+ characters)
#
# SALLA_TOKEN_ENC_KEY encrypts the Salla OAuth tokens at rest. LOSING IT makes
# every stored token unreadable and the Salla app has to be reinstalled by hand;
# CHANGING it does the same. Keep a copy somewhere that is not this server.
#
# QUOTE_IP_HASH_SALT salts the RFQ submitter IP hashes. An unsalted IP hash is
# reversed by exhausting IPv4 in minutes, so this is what makes `ip_hash` a
# column defensible under PDPL. Rotating it makes historical hashes
# incomparable with new ones — a real cost, not a free precaution.
# ===========================================================================
SALLA_TOKEN_ENC_KEY=
QUOTE_IP_HASH_SALT=

# ===========================================================================
# Salla integration
#
# From the Salla Partners dashboard, under your app. Client id and secret are on
# the Credentials tab; the webhook secret is on the Webhooks tab and is what the
# HMAC signature is checked against — a wrong value fails every delivery, which
# looks exactly like Salla not sending anything at all.
#
# Blank is a valid, working configuration: the site runs on the seeded catalog
# and the sync simply does nothing.
# ===========================================================================
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_WEBHOOK_SECRET=
SALLA_API_BASE=https://api.salla.dev/admin/v2
SALLA_OAUTH_TOKEN_URL=https://accounts.salla.sa/oauth2/token

# Which language the Salla store's own product text is written in. Decides
# whether a sync fills name_ar or name_en — and, more importantly, which of the
# two it leaves alone. Read CLAUDE.md § Deviations before changing it.
SALLA_STORE_LOCALE=ar

# ===========================================================================
# Operational
# ===========================================================================

# Bearer token for the /api/v1/admin/* endpoints (sync status, manual reconcile,
# event retry). BLANK LOCKS THEM ENTIRELY, which is the right setting until
# somebody actually needs them.
#   openssl rand -base64 24
ADMIN_API_KEY=

# Shared secret Nest presents when asking Next to purge an ISR cache tag. The
# same value must reach both containers or every purge is rejected and the site
# serves data up to five minutes stale — a failure with no visible symptom.
#   openssl rand -base64 24
REVALIDATE_SECRET=

# RFQ submissions permitted per client IP per hour.
QUOTE_RATE_LIMIT=5

# ===========================================================================
# Backups
#
# BACKUP_HOUR_UTC is UTC, not Riyadh time. 23:00 UTC is 02:00 Asia/Riyadh —
# genuinely quiet for a Saudi B2B site, which 23:00 local is not.
# ===========================================================================
BACKUP_RETENTION_DAYS=7
BACKUP_HOUR_UTC=23
