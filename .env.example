# ---------------------------------------------------------------------------
# Packvio — environment template.
# Copy to .env (root, used by docker-compose + apps/api) and fill in real values.
# Real .env files are gitignored. Never commit secrets.
# ---------------------------------------------------------------------------

# --- Database (apps/api + docker-compose) ----------------------------------
# Postgres connection string used by TypeORM (runtime + migration CLI).
DATABASE_URL=postgresql://packvio:packvio@localhost:5432/packvio

# Individual parts consumed by docker-compose to provision the postgres:16 container.
# Keep them in sync with DATABASE_URL above — if another Postgres already owns
# 5432 on your machine, change POSTGRES_PORT *and* the port in DATABASE_URL.
POSTGRES_USER=packvio
POSTGRES_PASSWORD=packvio
POSTGRES_DB=packvio
POSTGRES_PORT=5432

# --- Salla integration (apps/api only — the web app never calls Salla) ------
# OAuth app credentials from the Salla Partners dashboard.
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
# Shared secret used to verify the signature on incoming Salla webhooks.
# In the Salla Partners dashboard set the security strategy to "Signature" and
# paste the generated secret here. It must match exactly or every webhook 401s.
SALLA_WEBHOOK_SECRET=
# AES-256 key encrypting the OAuth tokens at rest in salla_tokens.
# REQUIRED — the API refuses to start without it and never falls back to plaintext.
# Generate one with:  openssl rand -base64 32
SALLA_TOKEN_ENC_KEY=
# Salla admin API base. Override only to point at a sandbox.
SALLA_API_BASE=https://api.salla.dev/admin/v2
# OAuth token endpoint used for the refresh_token grant.
SALLA_OAUTH_TOKEN_URL=https://accounts.salla.sa/oauth2/token

# --- Operational endpoints (apps/api) ---------------------------------------
# Shared secret for GET/POST /api/v1/admin/*. Sent as the x-admin-api-key header.
# Blank locks the admin endpoints entirely (fail closed).
ADMIN_API_KEY=

# --- API server (apps/api) --------------------------------------------------
# Port the NestJS server listens on. Routes are served under /api/v1.
API_PORT=4000
# Browser origin allowed by CORS — the Next.js site.
WEB_ORIGIN=http://localhost:3000

# --- Web app (apps/web) -----------------------------------------------------
# Base URL of the NestJS API, including the /api/v1 prefix. Public (inlined in the bundle).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Canonical public site URL — used for metadata, sitemap, hreflang alternates.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- On-demand revalidation (shared by apps/api and apps/web) ---------------
# Shared secret the API presents when asking Next.js to revalidate an ISR path
# after a write. Must be identical in both apps.
REVALIDATE_SECRET=change-me-in-production

# --- RFQ (quote requests) ---
# Salt for hashing submitter IPs. An UNSALTED IP hash is trivially reversible
# (only ~4.3bn IPv4 addresses), so this is what makes ip_hash non-personal data.
# Generate with: openssl rand -base64 32
QUOTE_IP_HASH_SALT=replace-me-with-openssl-rand-base64-32-output
# RFQ submissions allowed per IP per hour.
QUOTE_RATE_LIMIT=5

# Which language the Salla store's product content is authored in (ar|en).
SALLA_STORE_LOCALE=ar

# --- Contact map (OpenStreetMap embed, no API key) ---
NEXT_PUBLIC_MAP_LAT=24.7136
NEXT_PUBLIC_MAP_LNG=46.6753
NEXT_PUBLIC_MAP_ZOOM=14
