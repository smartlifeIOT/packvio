{
  "name": "@packvio/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript types (DTOs) consumed by apps/api and apps/web.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
